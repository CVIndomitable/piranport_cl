          "attachKeyFrame": true
        },
        {
          "type": "text",
          "duration": 80,
          "text": {
            "zh_cn": "右键弹药工作台打开合成界面。所有弹药统一在这里生产。",
            "en_us": "Right-click the Ammo Workbench to open the synthesis interface. All ammo is produced here."
          },
          "point": [2.5, 2.2, 2.5],
