  "editable": false,
  "scenes": [
    {
      "id": "sortie_supplies",
      "title": {
        "zh_cn": "出击前备齐补给",
        "en_us": "Stock Up Before Sortie"
      },
      "steps": [
        {
          "type": "show_structure",
          "structure": "ponderer:basic"
        },
        {
          "type": "idle",
          "duration": 20
        },
        {
          "type": "create_item_entity",
          "pos": [2.5, 2.5, 2.5],
