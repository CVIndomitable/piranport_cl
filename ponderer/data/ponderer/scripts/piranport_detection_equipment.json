        {"type": "create_item_entity", "item": "piranport:standard_aa_radar", "pos": [1.5, 3.0, 1.5]},
        {"type": "text", "duration": 110, "text": {"zh_cn": "对海雷达探测水面及水上目标，对空雷达探测空中目标；不同型号的探测距离不同。", "en_us": "Surface radar detects surface targets; air radar detects airborne targets. Detection range varies by model."}, "point": [3.5, 2.5, 2.5], "placeNearTarget": true, "attachKeyFrame": true},
        {"type": "idle", "duration": 120},
        {"type": "create_item_entity", "item": "piranport:standard_sonar", "pos": [2.5, 3.0, 1.5]},
        {"type": "indicate_success", "blockPos": [3, 1, 2]},
        {"type": "text", "duration": 110, "text": {"zh_cn": "舰装被动声呐还会标记附近非玩家生物，包括友方和陆地生物；发现标记后先辨认目标。", "en_us": "Core sonar also marks nearby non-player creatures, including friendly and land creatures. Identify a contact before attacking."}, "point": [2.5, 2.5, 1.5], "color": "green", "placeNearTarget": true, "attachKeyFrame": true},
        {"type": "idle", "duration": 120}
      ]
    },
    {
      "id": "fire_control", "title": {"zh_cn": "锁定与炮弹追踪", "en_us": "Target Lock and Shell Tracking"},
