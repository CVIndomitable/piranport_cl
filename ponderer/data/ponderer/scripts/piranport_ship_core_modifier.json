        },
        {
          "type": "create_item_entity",
          "pos": [0.5, 3.5, 2.5],
          "motion": [0.0, -0.03, 0.0],
          "count": 1,
          "item": "piranport:engine",
          "attachKeyFrame": false
        },
        {
          "type": "text",
          "duration": 80,
          "text": {
            "zh_cn": "在四个装备槽位放入要安装的部件——装甲板、引擎、声呐、修复套件等。",
            "en_us": "Slot the equipment you want installed — armor plates, engines, sonar, repair kits and more."
          },
          "point": [3.5, 3.4, 2.5],
          "color": "input",
          "placeNearTarget": true,
          "attachKeyFrame": true
        },
        {
          "type": "idle",
          "duration": 90
        },
        {
          "type": "indicate_success",
          "blockPos": [2, 1, 2],
          "attachKeyFrame": true
