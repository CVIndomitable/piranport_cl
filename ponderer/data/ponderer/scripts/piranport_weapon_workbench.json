  "editable": false,
  "scenes": [
    {
      "id": "weapon_synthesis",
      "title": {
        "zh_cn": "武器合成：GUI 流程",
        "en_us": "Weapon Synthesis: GUI Flow"
      },
      "steps": [
        {
          "type": "show_structure",
          "structure": "ponderer:basic"
        },
        {
          "type": "idle",
          "duration": 20
        },
        {
          "type": "set_block",
          "block": "piranport:weapon_workbench",
          "blockPos": [2, 1, 2],
          "attachKeyFrame": true
        },
        {
          "type": "text",
          "duration": 80,
          "text": {
            "zh_cn": "右键武器工作台打开合成界面。武器本体（火炮、发射器）在这里生产，弹药请改用弹药工作台。",
            "en_us": "Right-click the Weapon Workbench to open the synthesis GUI. This produces weapon items (cannons, launchers) — craft ammo at the Ammo Workbench instead."
          },
          "point": [2.5, 2.2, 2.5],
          "placeNearTarget": true,
          "attachKeyFrame": true
        },
        {
          "type": "idle",
          "duration": 90
        },
        {
          "type": "create_item_entity",
          "pos": [2.5, 3.5, 2.5],
          "motion": [0.0, -0.03, 0.0],
          "count": 1,
          "item": "minecraft:iron_ingot",
          "attachKeyFrame": true
        },
        {
          "type": "create_item_entity",
          "pos": [1.5, 3.5, 2.5],
          "motion": [0.0, -0.03, 0.0],
          "count": 1,
          "item": "minecraft:gunpowder",
          "attachKeyFrame": false
        },
        {
          "type": "text",
          "duration": 80,
          "text": {
            "zh_cn": "界面内按配方投入材料并点击合成。配方总类请参考 JEI。",
            "en_us": "Drop the right ingredients into the slots and click craft. Browse recipes in JEI."
          },
          "point": [2.5, 3.2, 2.5],
          "color": "input",
          "placeNearTarget": true,
          "attachKeyFrame": true
        },
        {
          "type": "idle",
          "duration": 90
        },
        {
          "type": "create_item_entity",
          "pos": [2.5, 3.5, 2.5],
          "motion": [0.0, -0.03, 0.0],
          "count": 1,
          "item": "piranport:small_gun",
          "attachKeyFrame": true
        },
        {
          "type": "indicate_success",
          "blockPos": [2, 1, 2],
          "attachKeyFrame": true
        },
        {
          "type": "text",
          "duration": 80,
          "text": {
            "zh_cn": "完成后产物进入输出槽。和弹药工作台一样，材料不会从漏斗自动消耗。",
            "en_us": "The finished weapon lands in the output slot. Same as the ammo workbench: hoppers do not feed ingredients."
          },
          "point": [2.5, 1.5, 2.5],
          "color": "green",
          "placeNearTarget": true,
          "attachKeyFrame": true
        },
        {
          "type": "idle",
          "duration": 90
        }
      ]
    },
    {
      "id": "weapon_in_use",
      "title": {
        "zh_cn": "占用保护与破坏归还",
        "en_us": "In-Use Lock and Break Refund"
      },
      "steps": [
        {
          "type": "show_structure",
          "structure": "ponderer:basic"
        },
        {
          "type": "idle",
          "duration": 20
        },
        {
          "type": "set_block",
          "block": "piranport:weapon_workbench",
          "blockPos": [2, 1, 2],
          "attachKeyFrame": true
        },
        {
          "type": "text",
          "duration": 80,
          "text": {
            "zh_cn": "工作台在合成中处于占用状态，其他玩家右键打开会失败并提示“工作台使用中”。",
            "en_us": "While a craft is running the bench is locked. Other players get a “workbench in use” message and cannot open it."
          },
          "point": [2.5, 2.2, 2.5],
          "placeNearTarget": true,
          "attachKeyFrame": true
        },
        {
          "type": "idle",
          "duration": 90
        },
        {
          "type": "create_item_entity",
          "pos": [2.5, 1.5, 2.5],
          "motion": [0.0, 0.05, 0.0],
          "count": 1,
          "item": "minecraft:iron_ingot",
          "attachKeyFrame": true
        },
        {
          "type": "create_item_entity",
          "pos": [1.5, 1.5, 2.5],
          "motion": [0.0, 0.05, 0.0],
          "count": 1,
          "item": "minecraft:iron_ingot",
          "attachKeyFrame": false
        },
        {
          "type": "text",
          "duration": 80,
          "text": {
            "zh_cn": "破坏方块会强制取消当前合成，槽内材料与已完成产物作为掉落物返回世界，不会丢失。",
            "en_us": "Breaking the block cancels the active craft. All stored materials and any finished product drop to the world — nothing is lost."
          },
          "point": [2.5, 0.8, 2.5],
          "color": "green",
          "placeNearTarget": true,
          "attachKeyFrame": true
        },
        {
          "type": "idle",
          "duration": 90
        }
      ]
    }
  ]
