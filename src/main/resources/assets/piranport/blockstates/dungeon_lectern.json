{
  "multipart": [
    {
      "when": { "facing": "south" },
      "apply": { "model": "piranport:block/dungeon_lectern" }
    },
    {
      "when": { "facing": "west" },
      "apply": { "model": "piranport:block/dungeon_lectern", "y": 90 }
    },
    {
      "when": { "facing": "north" },
      "apply": { "model": "piranport:block/dungeon_lectern", "y": 180 }
    },
    {
      "when": { "facing": "east" },
      "apply": { "model": "piranport:block/dungeon_lectern", "y": 270 }
    },
    {
      "when": { "facing": "south", "has_key": "true" },
      "apply": { "model": "piranport:block/dungeon_lectern_key" }
    },
    {
      "when": { "facing": "west", "has_key": "true" },
      "apply": { "model": "piranport:block/dungeon_lectern_key", "y": 90 }
    },
    {
      "when": { "facing": "north", "has_key": "true" },
      "apply": { "model": "piranport:block/dungeon_lectern_key", "y": 180 }
    },
    {
      "when": { "facing": "east", "has_key": "true" },
      "apply": { "model": "piranport:block/dungeon_lectern_key", "y": 270 }
    }
  ]
}
