<?xml version="1.0" encoding="UTF-8"?>
<!--
  PiranPort 调试日志配置。

  Per-player 会话：通过 PiranPortDebug.openSession() 在运行时为每个会话创建独立的
  RollingFileAppender + AsyncAppender（bounded queue, blocking=false），
  写入 logs/piranport-debug-<sessionId>.log；会话关闭时文件重命名为 .completed，
  并保留最近 5 个完整归档。

  此处只声明 Logger 名称与级别（INFO），具体 appender 由代码侧按需附加。
-->
<Configuration status="WARN">
    <Loggers>
        <Logger name="PiranPortDebug" level="INFO" additivity="false">
            <!-- appenders are added programmatically by PiranPortDebug.openSession() -->
        </Logger>
    </Loggers>
</Configuration>
